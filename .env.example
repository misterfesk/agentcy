# Runtime
ENV=development
LOG_LEVEL=INFO

# Database and cache
DATABASE_URL=postgresql+asyncpg://agentcy:agentcy@postgres:5432/agentcy
REDIS_URL=redis://redis:6379/0

# LLM
OPENROUTER_API_KEY=
DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Meta (kept disabled until business verification is complete)
ENABLE_META=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Safety controls
AUTO_REPLY_LIMIT_PER_THREAD_PER_MINUTE=3
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRIES=3
