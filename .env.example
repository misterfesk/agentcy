# Runtime
ENV=development
LOG_LEVEL=INFO

# Database and cache secret-file locations. These files are git-ignored.
POSTGRES_PASSWORD_FILE=.secrets/postgres_password
REDIS_PASSWORD_FILE=.secrets/redis_password

# Agent inference (Nebius Token Factory, OpenAI-compatible)
LLM_PROVIDER=nebius
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=glm5.3flash
NEBIUS_API_KEY_FILE=.secrets/nebius_api_key

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Meta (kept disabled until business verification is complete)
ENABLE_META=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Safety controls
AUTO_REPLY_LIMIT_PER_THREAD_PER_MINUTE=3
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRIES=3
